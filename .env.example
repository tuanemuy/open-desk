APP_URL=http://localhost:5173

# =============================================================================
# Database (SQLite / Turso)
# =============================================================================
# For local development (SQLite file):
SQLITE_URL=file:./data/local.db
# For production (Turso):
# SQLITE_URL=libsql://your-database.turso.io?authToken=your-auth-token

# =============================================================================
# Session
# =============================================================================
SESSION_SECRET=your-session-secret-min-32-chars

# =============================================================================
# Cloudflare R2 (File Storage — S3-compatible API)
# =============================================================================
# Optional: If not set, local filesystem (.storage/) is used
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=open-desk-files
# R2_PUBLIC_URL=https://files.example.com

# =============================================================================
# SMTP (Email Notifications — Nodemailer)
# =============================================================================
# For local development (Mailpit via docker-compose):
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# Mailpit Web UI: http://localhost:8025
# Optional: Override host ports to avoid conflicts with other projects
# MAILPIT_UI_PORT=8025

# =============================================================================
# Meilisearch (Full-text Search)
# =============================================================================
# For local development (docker-compose):
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=opendesk-dev-master-key
# Optional: Override host port to avoid conflicts with other projects
# MEILI_PORT=7700

# =============================================================================
# Web Push (Desktop Notifications — VAPID)
# =============================================================================
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
